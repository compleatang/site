{
	"$schema": "https://opencode.ai/config.json",
	"small_model": "ollama-cloud/gemma4:31b",
	"instructions": ["AGENTS.md", ".agents/rules/*.md"],
	"permission": {
		"read": {
			"*": "allow",
			".env": "deny",
			".env.*": "deny"
		},
		"edit": {
			"content/**": "allow",
			"templates/**": "allow",
			"static/**": "allow",
			"data/**": "allow"
		},
		"bash": {
			"seite build:*": "allow",
			"seite build": "allow",
			"seite new:*": "allow",
			"seite serve:*": "allow",
			"seite theme:*": "allow"
		},
		"glob": "allow",
		"grep": "allow",
		"websearch": "allow"
	},
	"mcp": {
		"seite": {
			"type": "local",
			"command": ["seite", "mcp"]
		}
	}
}
